# LMS Environment Configuration
# Copy this file to .env and fill in your values
# Never commit .env with real credentials

# Application
APP_ENV=development
APP_DEBUG=true
APP_NAME="Landlord Management System"

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://lms_user:change_me@localhost:5432/lms_dev

# Optional: Separate test database
# TEST_DATABASE_URL=postgresql+psycopg://lms_user:change_me@localhost:5432/lms_test

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Future: API
# API_HOST=0.0.0.0
# API_PORT=8000
# SECRET_KEY=generate_a_secure_random_key

# Future: External services
# ESEWA_MERCHANT_ID=
# KHALTI_SECRET_KEY=